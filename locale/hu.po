msgid "Enter a hex color code (e.g. #1E90FF), the way KOReader expects it. Leave empty to follow the card's usual background/theme color."
msgstr "Add meg a hex színkódot (pl. #1E90FF) úgy, ahogy a KOReader elvárja. Hagyd üresen, hogy a kártya kövesse a szokásos háttér/téma színét."

msgid "Not a valid hex color code, e.g. #1E90FF."
msgstr "Ez nem érvényes hex színkód, pl. #1E90FF."

msgid "Reset all colors to default"
msgstr "Összes szín visszaállítása alapértelmezettre"

msgid "Reset all colors to follow the theme again?"
msgstr "Visszaállítod az összes színt, hogy újra a témát kövessék?"

